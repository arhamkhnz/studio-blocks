{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "registry:build": {
      "inputs": ["src/registry/**", "scripts/*.mjs", "package.json"],
      "outputs": ["registry.json", "src/features/gallery/catalog.ts", "public/r/**"]
    },
    "build": {
      "dependsOn": ["^build", "registry:build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!public/r/**", "!registry.json", "!src/features/gallery/catalog.ts"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["registry:build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
